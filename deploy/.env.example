# Copy to deploy/.env and fill in. docker compose reads it automatically.

# Long and random. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public address of the shop's install
APP_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost

# Port nginx listens on
HTTP_PORT=80

DATABASE_NAME=codex
JWT_EXPIRES=1d

# Where nightly backups land on the host. Point this at a second disk.
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=14
